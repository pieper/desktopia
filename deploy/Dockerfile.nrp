# FUTURE / NOT USED FOR TESTING. The current NRP test path is deploy/nrp-desktopia.yaml — a stock
# ubuntu:24.04 pod that installs + runs the stack at runtime (push code with tar|kubectl exec). Once the
# pieces are proven on NRP, bake this self-contained image (FROM vanilla ubuntu, everything at build
# time -> fast cold pods, runs without runtime downloads) and push to GHCR via CI.
#
#   docker build -f deploy/Dockerfile.nrp -t ghcr.io/pieper/desktopia:nrp .   # (or via GitHub Actions)
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
COPY . /opt/desktopia
RUN bash /opt/desktopia/deploy/build-image.sh
ENV DESKTOPIA_WS_PLAIN=1 DESKTOPIA_HTTP_PORT=8080 NVIDIA_DRIVER_CAPABILITIES=all
EXPOSE 8080 4434
CMD ["bash", "/opt/desktopia/entrypoint-wayland.sh"]
