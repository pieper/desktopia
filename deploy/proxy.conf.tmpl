# Thin single-port reverse proxy (Cloud Run + local). Routes ONE listening port to the three internal
# backends; knows NOTHING about Slicer or desktopia internals -- just ports and paths. Independent layer.
#
#   /offload-ws   -> offload control WebSocket (:2028)
#   /offload/...  -> offload HTTP  (/mrml, /blob, /offload-bundle.js on :2027), prefix stripped
#   /             -> desktopia stream server: page (HTTP) + video WebSocket (:4434), distinguished by Upgrade
#
# Rendered at startup by envsubst (only ${PORT} is substituted; nginx's own $vars are left intact):
#   export PORT=${PORT:-8080}; envsubst '${PORT}' < proxy.conf.tmpl > /etc/nginx/conf.d/default.conf
# On Cloud Run, PORT is injected (default 8080) and this is the container's only exposed port.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  client_max_body_size 0;          # don't cap uploads (large DICOM / blobs)

  # offload control WebSocket
  location = /offload-ws {
    proxy_pass http://127.0.0.1:2028;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;       # long-lived
  }

  # offload HTTP (mrml / blob / bundle) -- strip the /offload/ prefix onto :2027
  location /offload/ {
    proxy_pass http://127.0.0.1:2027/;
    proxy_set_header Host $host;
  }

  # desktopia stream server: serves the page AND the video WebSocket on the same path (Upgrade decides)
  location / {
    proxy_pass http://127.0.0.1:4434;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }
}
