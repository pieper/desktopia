# Desktopia image for Kubernetes hosts (NRP/Nautilus). Unlike vast (base-by-reference + onstart),
# K8s needs a runnable image. PoC build: thin base + our scripts; entrypoint-wayland.sh installs deps
# and fetches the compositor (GHCR) + Slicer at first run. (Bake those in later for faster cold pods.)
#
# Build + push to the NRP in-cluster registry (fast pulls on Nautilus nodes):
#   docker build -f deploy/Dockerfile.nrp -t gitlab-registry.nrp-nautilus.io/<you>/desktopia:latest .
#   docker push gitlab-registry.nrp-nautilus.io/<you>/desktopia:latest
FROM vastai/base-image:stock-ubuntu24.04-py312-2026-06-04
COPY . /opt/desktopia
WORKDIR /opt/desktopia
# WS served plain (the NRP ingress terminates TLS); pod serves the client page on 8080.
ENV DESKTOPIA_WS_PLAIN=1 DESKTOPIA_HTTP_PORT=8080
EXPOSE 8080 4434
CMD ["bash", "/opt/desktopia/entrypoint-wayland.sh"]
